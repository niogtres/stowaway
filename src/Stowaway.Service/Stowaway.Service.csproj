<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The same executable also runs the notification-area app ("tray" mode). -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>Stowaway.Service</AssemblyName>
    <RootNamespace>Stowaway.Service</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- The SPA is built separately (web/) into wwwroot; see build.ps1 -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- Self-hosted Kestrel, not IIS. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- Generated from assets/brand by tools/generate-brand-assets.py -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <!-- Shipped next to the program (and so in the MSI), and shown on the About page. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- restic and rclone for Windows-container engines (tools\Get-BundledTools.ps1 downloads and verifies them). -->
    <None Include="..\..\tools\bin\*.exe" Link="tools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stowaway.Core\Stowaway.Core.csproj" />
    <ProjectReference Include="..\Stowaway.Docker\Stowaway.Docker.csproj" />
    <ProjectReference Include="..\Stowaway.Data\Stowaway.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Stowaway.Tests" />
  </ItemGroup>
  <!-- Fail a publish that would ship without the UI. -->
  <Target Name="EnsureWebUiBuilt" BeforeTargets="Publish" Condition="'$(SkipWebUiCheck)' != 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')" Text="wwwroot/index.html is missing. Build the web UI first (npm run build in web/) or run build.ps1." />
  </Target>
</Project>
