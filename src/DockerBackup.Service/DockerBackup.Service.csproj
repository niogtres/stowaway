<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>DockerBackup.Service</AssemblyName>
    <RootNamespace>DockerBackup.Service</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- The SPA is built separately (web/) into wwwroot; see build.ps1 -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- Self-hosted Kestrel, not IIS. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- Generated from assets/brand by tools/generate-brand-assets.py -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DockerBackup.Core\DockerBackup.Core.csproj" />
    <ProjectReference Include="..\DockerBackup.Docker\DockerBackup.Docker.csproj" />
    <ProjectReference Include="..\DockerBackup.Data\DockerBackup.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DockerBackup.Tests" />
  </ItemGroup>
  <!-- Fail a publish that would ship without the UI. -->
  <Target Name="EnsureWebUiBuilt" BeforeTargets="Publish" Condition="'$(SkipWebUiCheck)' != 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')" Text="wwwroot/index.html is missing. Build the web UI first (npm run build in web/) or run build.ps1." />
  </Target>
</Project>
