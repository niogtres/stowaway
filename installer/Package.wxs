<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Stowaway"
           Manufacturer="Thomas Kraft"
           Version="$(ProductVersion)"
           UpgradeCode="942968cc-ff01-48e4-a420-8699ce89db23"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Stowaway: Sensible Docker backup management" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPHELPLINK" Value="https://localhost:8484/help" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/niogtres/stowaway" />

    <!-- Add/Remove Programs icon. Generated by tools/generate-brand-assets.py. -->
    <Icon Id="AppIcon" SourceFile="..\src\Stowaway.Service\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Wizard: Welcome -> install folder -> ready -> progress -> finish. The licence page is skipped: MIT needs no
         acceptance (LICENSE.txt is installed next to the program and shown on the About page). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUIDialogBmp" Value="assets\dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="assets\banner.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="assets\License.rtf" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="99" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenUi"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="StartTray" Condition="NOT Installed" />

      <!-- What the progress page says while each step runs. Without these the page keeps showing "Validating install"
           through the slow steps (removing the old version, copying files, stopping and starting the service). -->
      <ProgressText Action="InstallValidate" Message="Checking for programs that are using Stowaway's files" />
      <ProgressText Action="InstallInitialize" Message="Preparing to install (Windows may save a System Restore point first, which can take a minute or two)" />
      <ProgressText Action="RemoveExistingProducts" Message="Removing the previous version: stopping the Stowaway service and removing its files" />
      <ProgressText Action="StopServices" Message="Stopping the Stowaway service (it finishes what it's doing first, which can take up to half a minute)" />
      <ProgressText Action="DeleteServices" Message="Removing the Stowaway service" />
      <ProgressText Action="RemoveFiles" Message="Removing old files" Template="[1]" />
      <ProgressText Action="InstallFiles" Message="Copying files (about 250 MB; your antivirus checks each new program file)" Template="[1]" />
      <ProgressText Action="WriteRegistryValues" Message="Writing settings" />
      <ProgressText Action="InstallServices" Message="Registering the Stowaway service" />
      <ProgressText Action="StartServices" Message="Starting the Stowaway service (the first start after an update can take a minute)" />
      <ProgressText Action="UninstallCleanup" Message="Removing Stowaway's certificate and event log source" />
      <ProgressText Action="InstallFinalize" Message="Finishing" />
    </UI>

    <!-- Finish page: offer to open the UI (the service is already started by ServiceControl). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Stowaway in your browser" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="https://localhost:8484/" />
    <CustomAction Id="OpenUi" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />

    <!-- Finish page: start the tray for the installing user now (it otherwise starts at the next sign-in).
         Runs in the wizard's own process, so in the user's session. Silent installs skip it. -->
    <CustomAction Id="StartTray" FileRef="ServiceExe" ExeCommand="--tray" Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Stowaway" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProductMenuFolder" Name="Stowaway" />
    </StandardDirectory>

    <Feature Id="Main" Title="Stowaway" AllowAbsent="no">
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="TrayAutostart" />
    </Feature>

    <!-- On uninstall (not upgrade): remove the certificate the service trusted and its event source. -->
    <CustomAction Id="UninstallCleanup" FileRef="ServiceExe" ExeCommand="--uninstall-cleanup" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="UninstallCleanup" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="ServiceComponents" Directory="INSTALLFOLDER">
      <Component Id="ServiceExecutable">
        <File Id="ServiceExe" Source="$(PublishDir)Stowaway.Service.exe" KeyPath="yes" />

        <ServiceInstall Id="StowawayService"
                        Name="Stowaway"
                        DisplayName="Stowaway"
                        Description="Sensible Docker backup management: scheduled backup and restore for Docker containers and volumes. UI: https://localhost:8484/"
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <ServiceConfig DelayedAutoStart="yes" OnInstall="yes" OnReinstall="yes" />
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="30"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="StowawayService" Name="Stowaway" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>

      <!-- Everything else in the publish folder (appsettings, wwwroot/**), harvested at build time. -->
      <Files Include="$(PublishDir)**">
        <Exclude Files="$(PublishDir)Stowaway.Service.exe" />
        <Exclude Files="$(PublishDir)*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- The tray app starts at every user's logon. -->
    <Component Id="TrayAutostart" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="StowawayTray"
                     Type="string" Value="&quot;[INSTALLFOLDER]Stowaway.Service.exe&quot; --tray" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="ProductMenuFolder">
      <util:InternetShortcut Id="OpenUi" Name="Stowaway" Target="https://localhost:8484/" Type="url" />
      <RemoveFolder Id="RemoveProductMenuFolder" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\Stowaway" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
