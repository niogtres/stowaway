<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Build after publishing the service (see build.ps1):
      dotnet build installer/Stowaway.Installer.wixproj -c Release -p:ProductVersion=1.2.3
  -->
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\</PublishDir>
    <PublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</PublishDir>
    <PublishDir Condition="!HasTrailingSlash('$(PublishDir)')">$(PublishDir)\</PublishDir>
    <OutputName>Stowaway-$(ProductVersion)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- WIX1149: MSI ServiceConfig is only used for DelayedAutoStart, which works on all supported Windows versions. -->
    <SuppressSpecificWarnings>1149</SuppressSpecificWarnings>
    <!-- ICE38/ICE43: false positives for a per-machine install; ProgramMenuFolder resolves to the all-users Start menu. -->
    <SuppressIces>ICE38;ICE43</SuppressIces>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>
  <Target Name="EnsurePublished" BeforeTargets="Build">
    <Error Condition="!Exists('$(PublishDir)Stowaway.Service.exe')" Text="Service not published to $(PublishDir). Run build.ps1 or dotnet publish first." />
    <Error Condition="!Exists('$(PublishDir)wwwroot\index.html')" Text="Web UI missing from $(PublishDir)wwwroot. Build web/ before publishing." />
  </Target>
</Project>
